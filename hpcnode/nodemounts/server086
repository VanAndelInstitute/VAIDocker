if ! [ -e /dev/disk/by-path/pci-0000:11:00.0-nvme-1-part1 ]; then
        parted -a optimal /dev/disk/by-path/pci-0000:11:00.0-nvme-1 mklabel gpt
        sleep 5
        parted -a optimal /dev/disk/by-path/pci-0000:11:00.0-nvme-1 mkpart primary 0% 100%
        sleep 5
        mkfs.xfs /dev/disk/by-path/pci-0000:11:00.0-nvme-1-part1
        sleep 5
fi

if ! [ -e /dev/disk/by-path/pci-0000:14:00.0-nvme-1-part1 ]; then
        parted -a optimal /dev/disk/by-path/pci-0000:14:00.0-nvme-1 mklabel gpt
        sleep 5
        parted -a optimal /dev/disk/by-path/pci-0000:14:00.0-nvme-1 mkpart primary 0% 100%
        sleep 5
        mkfs.xfs /dev/disk/by-path/pci-0000:14:00.0-nvme-1-part1
        sleep 5
fi

mkdir -p /localdisk/data
mountpoint -q /localdisk/data || mount /dev/disk/by-path/pci-0000:11:00.0-nvme-1-part1  /localdisk/data

mkdir -p /localdisk/data2
mountpoint -q /localdisk/data2 || mount /dev/disk/by-path/pci-0000:14:00.0-nvme-1-part1  /localdisk/data2
