if ! mountpoint -q /localdisk/data; then
	dnf install https://zfsonlinux.org/epel/zfs-release-2-3$(rpm --eval "%{dist}").noarch.rpm -y
	yum install --disableexcludes=all zfs -y
	/sbin/modprobe zfs
	zfs mount -a
	zpool import -a
	mkdir -p /localdisk/data
	zfs set mountpoint=/localdisk/data data
fi


if ! mountpoint -q /localdisk/data ; then
	mount /dev/disk/by-path/pci-0000:00:1f.2-ata-2-part1 /localdisk/data1
fi
